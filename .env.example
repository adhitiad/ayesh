# === Pilih provider ===
# Bawaan: nvidia | groq | google | openai | ollama
# Tambahan: anthropic | cohere | deepseek | moonshot | minimax | openrouter |
#           grok (xAI) | zai (glm) | meta (Llama API) | <nama-lain> generik
# Provider tak dikenal otomatis dicoba sebagai endpoint OpenAI-compatible
# bila <NAMA>_BASE_URL (+ LLM_MODEL) diisi.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7

# === NVIDIA NIM ===
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# === Groq (gratis, cepat) — https://console.groq.com/keys ===
GROQ_API_KEY=your_groq_api_key_here

# === Google Gemini (gratis tier) — https://aistudio.google.com/apikey ===
GOOGLE_API_KEY=your_google_api_key_here
# Tools native Gemini (server-side, hanya bila provider google aktif).
# Pilihan: google_search, code_execution, url_context — kosong = mati.
# GOOGLE_NATIVE_TOOLS=google_search,url_context

# === OpenAI ===
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# === Anthropic (Claude) — https://console.anthropic.com ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# === Cohere (Command) — https://dashboard.cohere.com/api-keys ===
COHERE_API_KEY=your_cohere_api_key_here
# COHERE_BASE_URL=https://api.cohere.com/v2

# === DeepSeek (OpenAI-compatible) — https://platform.deepseek.com ===
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# === Moonshot / Kimi (OpenAI-compatible) — https://platform.moonshot.ai ===
MOONSHOT_API_KEY=your_moonshot_api_key_here
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# === MiniMax (OpenAI-compatible) — https://www.minimax.io ===
MINIMAX_API_KEY=your_minimax_api_key_here
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# === OpenRouter (agregator, OpenAI-compatible) — https://openrouter.ai/keys ===
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === xAI / Grok (OpenAI-compatible) — https://console.x.ai ===
XAI_API_KEY=your_xai_api_key_here
# XAI_BASE_URL=https://api.x.ai/v1

# === Z.AI / GLM (OpenAI-compatible) — https://z.ai ===
ZAI_API_KEY=your_zai_api_key_here
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# === Meta Llama API (OpenAI-compatible) — https://llama.com ===
META_API_KEY=your_meta_api_key_here
# META_BASE_URL=https://api.llama.com/v1

# === Redis & PostgreSQL ===
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://user:password@localhost:5432/multiagent

# Enkripsi at-rest kolom sensitif DB (Fernet). Kosong = fitur OFF (plaintext,
# kompatibel instalasi lama). Set agar session_memory.content, sessions.context,
# pending_approvals.args, preferensi.value, scheduled_jobs.prompt, dan
# background_tasks.input/result tersimpan terenkripsi.
# Generate key: python -m src.core.db.encryption --generate-key
# Enkripsi data lama: python -m src.core.db.encryption --encrypt-existing
DB_SECRET_KEY=

# === API server ===
API_HOST=127.0.0.1
API_PORT=8080
REQUIRE_API_KEY=1

# Rotasi API key (`POST /users/{id}/rotate`): key lama tetap valid selama N jam (default 24).
API_KEY_ROTATION_GRACE_HOURS=24

# === Approval manusia (HITL), scheduler, varian prompt ===
REQUIRE_APPROVAL=0
APPROVAL_TIMEOUT_S=600
ENABLE_SCHEDULER=0
PROMPT_VARIANT=full

# === Cost tracking (estimasi USD per request, /usage/summary) ===
# Harga per-1M token USD dipakai hanya untuk model yang TIDAK dikenal tabel
# harga bawaan (src/core/observability/pricing.py). Kosongkan untuk biaya 0.
# COST_PER_1M_PROMPT=0.85
# COST_PER_1M_COMPLETION=2.1

# === Structured logging JSON (request ID tracing) ===
# Aktif default; set 0 untuk nonaktif. File rotasi 5MB x 3.
LOG_JSON_ENABLED=1
LOG_JSON_FILE=logs/ayesh.jsonl

# === Model routing per task (pilih provider/model per jenis tugas) ===
# Default OFF (0) → perilaku sama dengan get_llm() biasa. Aktif bila 1.
# Format per task: MODEL_ROUTE_<TASK>=provider[:model]
# Task: CODE, ADMIN, CHAT, PLAN, SUMMARIZE (lihat src/core/llm/task_routing.py).
# Resolve gagal / key kosong → fallback otomatis ke get_llm() (fail-closed).
# MODEL_ROUTING_ENABLED=1
# MODEL_ROUTE_CODE=deepseek:deepseek-chat
# MODEL_ROUTE_CHAT=groq

# === VIP & Payment (stub webhook) ===
# Harga VIP $13.87 = 1387 cents. Webhook: POST /webhooks/vip-upgrade (HMAC, idempotent).
# VIP_WEBHOOK_SECRET wajib diisi agar webhook aktif (kosong = 503 fail-closed).
# VIP_PRICE_CENTS=1387
# VIP_WEBHOOK_SECRET=change_me_to_random_32chars
# Model premium hanya vip/owner (comma list, kosong = semua boleh):
# VIP_ONLY_MODELS=gpt-4o,claude-opus,gemini-2.5-pro
# REGISTER_ENABLED=1

# === Rate limit (Redis-backed, per-IP + per-user, vip = user*2 burst / *4 sustained) ===
# Per-scope default: chat (10/s, 30/min); tasks/jobs/approvals/feedback (5/s, 20/min);
# users (2/s, 5/min); register (2/s, 5/min); webhooks (5/s, 20/min).
# Override per-IP, per-user, per-vip:
# RATE_LIMIT_CHAT_BURST=10
# RATE_LIMIT_CHAT_SUSTAINED=30
# RATE_LIMIT_CHAT_USER_BURST=10
# RATE_LIMIT_CHAT_USER_SUSTAINED=30
# RATE_LIMIT_CHAT_VIP_BURST=20
# RATE_LIMIT_CHAT_VIP_SUSTAINED=120
# RATE_LIMIT_REGISTER_BURST=2
# RATE_LIMIT_REGISTER_SUSTAINED=5

# === Telegram bot (opsional) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_ALLOWED_IDS=12345,67890

# === Kunci pencarian web & MCP (dipakai via ${...} di mcp_core/mcp.json) ===
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
HF_TOKEN=your_huggingface_token_here
