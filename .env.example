# === Pilih provider ===
# Bawaan: nvidia | groq | google | openai | ollama
# Tambahan: anthropic | cohere | deepseek | moonshot | minimax | openrouter |
#           grok (xAI) | zai (glm) | meta (Llama API) | <nama-lain> generik
# Provider tak dikenal otomatis dicoba sebagai endpoint OpenAI-compatible
# bila <NAMA>_BASE_URL (+ LLM_MODEL) diisi.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7

# === NVIDIA NIM ===
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# === Groq (gratis, cepat) — https://console.groq.com/keys ===
GROQ_API_KEY=your_groq_api_key_here

# === Google Gemini (gratis tier) — https://aistudio.google.com/apikey ===
GOOGLE_API_KEY=your_google_api_key_here
# Tools native Gemini (server-side, hanya bila provider google aktif).
# Pilihan: google_search, code_execution, url_context — kosong = mati.
# GOOGLE_NATIVE_TOOLS=google_search,url_context

# === OpenAI ===
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# === Anthropic (Claude) — https://console.anthropic.com ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# === Cohere (Command) — https://dashboard.cohere.com/api-keys ===
COHERE_API_KEY=your_cohere_api_key_here
# COHERE_BASE_URL=https://api.cohere.com/v2

# === DeepSeek (OpenAI-compatible) — https://platform.deepseek.com ===
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# === Moonshot / Kimi (OpenAI-compatible) — https://platform.moonshot.ai ===
MOONSHOT_API_KEY=your_moonshot_api_key_here
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# === MiniMax (OpenAI-compatible) — https://www.minimax.io ===
MINIMAX_API_KEY=your_minimax_api_key_here
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# === OpenRouter (agregator, OpenAI-compatible) — https://openrouter.ai/keys ===
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === xAI / Grok (OpenAI-compatible) — https://console.x.ai ===
XAI_API_KEY=your_xai_api_key_here
# XAI_BASE_URL=https://api.x.ai/v1

# === Z.AI / GLM (OpenAI-compatible) — https://z.ai ===
ZAI_API_KEY=your_zai_api_key_here
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# === Meta Llama API (OpenAI-compatible) — https://llama.com ===
META_API_KEY=your_meta_api_key_here
# META_BASE_URL=https://api.llama.com/v1

# === Redis & PostgreSQL ===
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://user:password@localhost:5432/multiagent

# === API server ===
API_HOST=127.0.0.1
API_PORT=8080
REQUIRE_API_KEY=1

# === Approval manusia (HITL), scheduler, varian prompt ===
REQUIRE_APPROVAL=0
APPROVAL_TIMEOUT_S=600
ENABLE_SCHEDULER=0
PROMPT_VARIANT=full

# === Telegram bot (opsional) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_ALLOWED_IDS=12345,67890

# === Kunci pencarian web & MCP (dipakai via ${...} di mcp_core/mcp.json) ===
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
HF_TOKEN=your_huggingface_token_here
